  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Active Spot Runner Nodes vs. Pending Pods",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "count(kube_node_labels{label_karpenter_sh_nodepool=\"spot-runners\"}) or vector(0)",
          "legendFormat": "Active EC2 Spot Runner Nodes",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{namespace=\"arc-runners\", phase=\"Pending\"}) or vector(0)",
          "legendFormat": "Pending Runner Pods",
          "range": true,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Karpenter Provisioning Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(karpenter_nodeclaims_created[5m])) or vector(0)",
          "legendFormat": "Node Claims Created / sec",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Estimated AWS Spot Cost Savings vs. On-Demand Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "(count(kube_node_labels{label_karpenter_sh_capacity_type=\"spot\"}) * 68) or vector(0)",
          "legendFormat": "Spot Cost Reduction %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 65
              }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Active Ephemeral Pod Execution Count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{namespace=\"arc-runners\", phase=\"Running\"}) or vector(0)",
          "legendFormat": "Running Pods",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1
          },
          "unit": "short"
        }
      }
    }
  ],
